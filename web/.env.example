# Copia este archivo como .env.local y rellena lo que uses. Nunca subas .env.local al repositorio.
# Sin nada configurado la app arranca en "modo desarrollo": login de prueba, pago simulado y datos en .data/.

# ---------- Sitio ----------
# URL pública, sin barra final. En local: http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_NOMBRE_SITIO="IA en Producción"
NEXT_PUBLIC_CONTACTO=
# Correos (separados por coma) que ven /admin y tienen acceso completo. Deben estar verificados en Auth0.
ADMIN_EMAILS=

# ---------- Auth0 (aplicación de tipo "Regular Web Application") ----------
# Allowed Callback URLs:  <APP_BASE_URL>/auth/callback      Allowed Logout URLs:  <APP_BASE_URL>
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32 bytes en hexadecimal:  openssl rand -hex 32
AUTH0_SECRET=

# ---------- Base de datos (Postgres: Neon, Supabase, etc.) ----------
# Las tablas se crean solas en la primera consulta.
DATABASE_URL=

# ---------- Precios ----------
# Moneda en la que cobra la pasarela y monto de cada plan en esa moneda (unidades, no centavos).
# Con PAGOS_MONEDA=USD y sin PRECIO_*, se usan 10 / 100 / 40.
PAGOS_MONEDA=COP
PRECIO_MENSUAL=
PRECIO_ANUAL=
PRECIO_CURSO=

# ---------- Mercado Pago (Checkout Pro) ----------
# Webhook: <APP_BASE_URL>/api/webhooks/mercadopago  (evento "Pagos")
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---------- Wompi (Web Checkout, solo COP) ----------
# URL de eventos: <APP_BASE_URL>/api/webhooks/wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# ---------- Lemon Squeezy (Hosted Checkout en USD, global) ----------
# Webhook: <APP_BASE_URL>/api/webhooks/lemonsqueezy (eventos order_created y order_refunded)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_MENSUAL=
LEMONSQUEEZY_VARIANT_ANUAL=
LEMONSQUEEZY_VARIANT_CURSO=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ---------- Transferencia manual (opcional) ----------
# Si lo defines, /comprar muestra estas instrucciones y tú activas el acceso desde /admin.
PAGO_MANUAL_INSTRUCCIONES=
