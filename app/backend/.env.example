# Copia este archivo como .env (en esta misma carpeta backend/) y rellena lo que uses.
# Estas variables llegan al kernel: los ejercicios del laboratorio las leen con os.environ.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Modelo por defecto de los ejemplos
MODELO=gpt-4.1-mini

# Embeddings: openai (necesita OPENAI_API_KEY) | local (sentence-transformers, sin API, privado)
EMB_BACKEND=local
# EMB_MODEL depende del backend elegido:
#   local  -> sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (~470 MB, multilingüe)
#             o BAAI/bge-m3 (mejor, ~2.2 GB)
#   openai -> text-embedding-3-small
EMB_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Qdrant: http://localhost:6333 (servidor Docker) | :memory: (embebido, sin Docker)
QDRANT_URL=:memory:

# Orígenes del frontend autorizados (CORS)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Límite de tiempo por celda del laboratorio, en segundos
KERNEL_TIMEOUT=120
